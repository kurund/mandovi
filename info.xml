<?xml version="1.0"?>
<extension key="mandovi" type="module">
  <file>mandovi</file>
  <name>Mandovi</name>
  <description>Mandovi: a calm, modern Riverlea stream for staff users, with light and dark modes.</description>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>Kurund Jalmi</name>
      <email>kurundjalmi@thirdsectordesign.org</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://github.com/kurund/mandovi</url>
    <url desc="Support">https://github.com/kurund/mandovi</url>
    <url desc="Licensing">https://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-11-05</releaseDate>
  <version>1.0.0</version>
  <develStage>alpha</develStage>
  <compatibility mode="semver">
    <ver>6.21</ver>
  </compatibility>
  <php_compatibility mode="list">
    <ver>8.1</ver>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
  </php_compatibility>
  <smarty_compatibility mode="list">
    <ver>5</ver>
  </smarty_compatibility>
  <requires>
    <ext>riverlea</ext>
  </requires>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Mandovi</namespace>
    <format>26.10.3</format>
    <angularModule>crmMandovi</angularModule>
  </civix>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
